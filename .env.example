# ============================================================
# CHV HOST — Environment Configuration
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to git. Never expose these values to the
# browser — all secrets are only read on the server.
# ============================================================

# ---------- Business Information ----------
SITE_NAME="CHV HOST"
SITE_TAGLINE="Cheap Hosting And VPS"
SITE_DOMAIN="https://yourdomain.com"
SUPPORT_EMAIL="support@yourdomain.com"
SALES_EMAIL="sales@yourdomain.com"
SUPPORT_PHONE="+880XXXXXXXXXX"
COMPANY_ADDRESS="Your Address, Bangladesh"

# ---------- Branding ----------
LOGO_PATH="/logo.png"
FAVICON_PATH="/favicon.ico"
PRIMARY_COLOR="#4f46e5"
SECONDARY_COLOR="#06b6d4"

# ---------- Analytics (optional) ----------
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ---------- WHMCS ----------
WHMCS_URL="https://billing.yourdomain.com"
WHMCS_API_URL="https://billing.yourdomain.com/includes/api.php"
WHMCS_IDENTIFIER=""
WHMCS_SECRET=""
WHMCS_ACCESS_KEY=""
# When true, the site uses built-in demo/mock product data instead of
# contacting WHMCS. Set to false once WHMCS credentials are configured.
USE_WHMCS_PRODUCTS="false"
# Seconds before a WHMCS API request times out.
WHMCS_TIMEOUT_MS="8000"

# ---------- WHM / cPanel (provisioning) ----------
WHM_HOST=""
WHM_USERNAME=""
WHM_API_TOKEN=""

# ---------- ZiniPay ----------
ZINIPAY_API_KEY=""
ZINIPAY_BASE_URL="https://api.zinipay.com"
ZINIPAY_SANDBOX="true"
# Secret used to sign/authenticate ZiniPay callbacks (set if the
# ZiniPay account supports webhook signing; otherwise leave empty).
ZINIPAY_WEBHOOK_SECRET=""
# External base URL used to build the ZiniPay callback/return URLs.
APP_BASE_URL="http://localhost:3000"
# Where the storefront redirects after a successful payment.
PAYMENT_SUCCESS_URL="/payment/success"
PAYMENT_CANCEL_URL="/payment/cancelled"

# ---------- Optional Domain Registrar ----------
# If no registrar is configured, domain search runs in "mock" mode
# using configurable prices from content/domain-prices.json
DOMAIN_REGISTRAR=""
DOMAIN_REGISTRAR_API_KEY=""
DOMAIN_REGISTRAR_API_SECRET=""

# ---------- Admin ----------
# Password for the /admin content editor (change me).
ADMIN_PASSWORD="change-me-before-deploy"

# ---------- Support / Live chat ----------
LIVE_CHAT_PROVIDER_URL=""

# ---------- SMTP (contact form + notifications) ----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CHV HOST <no-reply@yourdomain.com>"
